// examples/concurrency_cancel.wll — spec v0.7 §17.3 golden shape
// SHIELD + TASK_CANCEL_PARENT + TASK_IS_CANCELLED + ChannelClosed kind.
// Expected stdout:
//   [TRUE, TRUE]
//   PASS:concurrency_cancel
//   PASS:channel_closed_kind
//
// (the `kind` value is only *compared* — `==(kind, "ChannelClosed")` — it is
//  never PRINTed, so no "ChannelClosed" line appears on stdout)
//
// Rules locked here:
//  * SHIELD defers cancel until the outermost SHIELD exits
//  * SHIELD does NOT absorb the fn body's own ERR
//  * cancel itself returns NULL (no ERR)
//  * close signal is ERR(kind="ChannelClosed")

LET(obs, SCOPE(FUN(() ,
    LET(h, SPAWN(FUN(() ,
        SHIELD(FUN(() , TASK_CANCEL_PARENT()));
        LET(c, TASK_IS_CANCELLED());
        LET(r, SHIELD(FUN(() , TRY(ERR("inner")))));
        // [v1.0 规范 §8.6] `IS_ERR` 是**观察型**消费者 —— 它不解除未消费状态
        // (§8.6.1)⇒ `r` 里的那个 `ERR` 到作用域结束时仍未被消费 ⇒ 那是丢弃点
        // (§8.6.2 第 3 项)⇒ 报 `E0103`。所以观察之后必须**显式丢弃**:
        // `LET(_, …)` 是本语言唯一的显式丢弃构造(§8.6.4)。
        LET(observed, IS_ERR(r));
        LET(_, r);
        [c, observed]
    )));
    AWAIT(h)
)));
PRINT(obs);
IF(==(obs[0], TRUE),
    IF(==(obs[1], TRUE), PRINT("PASS:concurrency_cancel"), PRINT("FAIL:err")),
    PRINT("FAIL:cancel"));

LET(kind, SCOPE(FUN(() ,
    LET(ch, CHANNEL_NEW(0));
    CHANNEL_CLOSE(ch);
    LET(h, SPAWN(FUN(() ,
        LET(r, CHANNEL_RECV(ch));
        AT_K(ERR_PAYLOAD(r), "kind", "?")
    )));
    AWAIT(h)
)));
IF(==(kind, "ChannelClosed"), PRINT("PASS:channel_closed_kind"), PRINT("FAIL:kind"))
