// examples/format.wll — FORMAT builtin + template syntax (§10.6)
// Demonstrates: positional `{0}` and named `{name}` placeholders.
// Phase B5 implements the global `FORMAT(...)` builtin.
// (v0.4 note: dict literals use the `[k: v]` form; `{}` braces are
// not part of the language, and `:fmt` specifiers are not defined.)

LET(greeting, FORMAT("Hello, {0}!", "world"));
PRINT(greeting);

LET(rect, FORMAT("rect={width}x{height}", ["width": 320, "height": 200]));
PRINT(rect);

LET(pi, FORMAT("pi={value}", ["value": 3.14159]));
PRINT(pi);
