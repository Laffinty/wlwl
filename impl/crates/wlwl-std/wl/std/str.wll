// wlwl:std.str — R1 语言层(标准库底座 v0.11,ADR-0021)
// 成员契约:docs/wlwl-spec-reference.md §6;注册镜像:附录 A。
// M1 只落地 QUOTE 一项证明双轨通道;M3 落齐 §6 全部成员。
//
// 本模块只**补**全局内建(语言规范 §10.5)没有的能力,不重导出任何全局内建
// —— §6 明文要求。`SPLIT` / `SUB` / `ENDS_WITH` / `LEN` 是全局内建,在这里
// 只是被**调用**,不是被导出。
//
// ## 三个「**不要新增同义成员**」的口径
//
// ⚠ **数字转字符串用全局内建 `STR(x)`**(语言规范 §10.3;实现侧是
//   `wlwl-eval/src/registry.rs` 的全局内建表)。`std.text` **没有**
//   `TO_STRING` 这个成员 ⇒ **不要**新增一个同义成员:一个语义一个名字
//   (与 `std.result` 的 `ADR-0029` §4b「不复刻」同款裁决)。
// ⚠ **`+` 是二元的、且不做隐式强转**:`"a" + 1` ⇒ `E0030: +: cannot add
//   string and integer`。⇒ 拼多段要么用本模块的 `CAT(...)`(变长、逐段 `STR`
//   渲染),要么逐段 `STR(...)` 之后再 `+`。
// ⚠ **`SPLIT(s, sep)` 是全局内建**(语言规范 §10.5)⇒ 本模块**不导出**它。
//   `SPLIT_LINES` 是**另一件事**(按 `\n` 切行、去行尾 `\r`、丢末尾空行),
//   不是「通用切分」的别名 —— 别拿它当 `SPLIT` 用。
//
// 诊断走 M3-0 的注入 kernel(`_KIND` / `_DIAG_E0030`);元数错由解释器自己
// 报(固定元数的成员拿到的是 `function expects 1..1 argument(s)` 这条无名前缀
// 的 E0022 —— 见 std/collection.wll 头部同款说明)。

// 唯一的跨命名空间依赖:`wlwl:std.encode` 的 `URL_DECODE`(R2 原生,已登记)。
//
// ⚠ **为什么依赖它而不是自己写解码器**:百分号解码(`%XX`)是一段有明确
//   边界规则的字节处理(非法转义、截断转义、解出来不是合法 UTF-8),仓里
//   已经有**一份**实现 ⇒ 自己再写一份就是两份口径迟早漂移。
// ⚠ **它不折 `+`**:那是 RFC 3986 与 `application/x-www-form-urlencoded`
//   的分歧(§11.3-2 明文),`+` → 空格由本模块在调用**之前**做(见
//   `_QUERY_DECODE` 的注释)。
//
// ⚠ **它不在 `EXPORT` 名单里** ⇒ 不进附录 A、不在 `IMPORT` 面上。
IMPORT("wlwl:std.encode", ["URL_DECODE"]);

// ── 助手(不导出)────────────────────────────────────────────────────

// 拼消息(模块私有的**纯字符串**拼接:只拼 STRING,段不是字符串直接 E0030 ——
// 与公开成员 `CAT` 的「逐段 `STR` 渲染」是**两件不同的事**,别混)。
//
// ⚠ 名字是 `_MSG` 而不是 `_CAT`:`_CAT` 现在是**注入进来的 R2 内核**
//   (公开成员 `CAT` 的实现)。模块源码在 kernel 注入**之后**求值 ⇒ 同一个
//   名字会被这里 `LET` 一次 ⇒ 内核会被顶掉 ⇒ 公开成员会退化成闭包。
//   (这正是 `std.result` 的 `RESULT_ALL` 用 `_RESULT_ALL` 的同款理由。)
LET(_MSG, FUN((*parts), (LET MUT(s, ""); FOR(p, parts, SET(s, +(s, p))); s)));

// `NAME: expected <what>, got <kind>`
LET(_NEED, FUN((name, what, ty, v),
    IF(==(TYPE(v), ty), v, _DIAG_E0030(_MSG(name, ": expected ", what, ", got ", _KIND(v))))));

LET(_NEED_ARR, FUN((name, v), _NEED(name, "array", "ARRAY", v)));
LET(_NEED_STR, FUN((name, v), _NEED(name, "string", "STRING", v)));
LET(_NEED_INT, FUN((name, v), _NEED(name, "integer", "INTEGER", v)));

// 元数窗口 [lo, hi]。与 collection.wll 同款;措辞也照抄 R2 的口径
// (只报上限)。
LET(_NEED_ARITY, FUN((name, args, lo, hi),
    IF(||(<(LEN(args), lo), >(LEN(args), hi)),
       _DIAG_E0022(_MSG(name, ": function expects ", STR(hi), " argument(s), got ", STR(LEN(args)))),
       NULL)));

// 被检索的子串。非空是**硬要求**,不是「空串退化成某种答案」——
// 同模块的 `COUNT` 早就对空 sub 报 E0030(见下),这里必须同一个口径。
// 两个新成员若各发明一条空串规则,`CONTAINS_SUB(s, "")` 到底是 TRUE
// 还是报错就变成了读过哪份文档的事。
LET(_NEED_SUB, FUN((name, v),
    (LET(sub, _NEED_STR(name, v));
     IF(==(sub, ""),
        _DIAG_E0030(_MSG(name, ": sub must not be an empty string")),
        NULL);
     sub)));

// ── JOIN(arr, sep) -> STRING ────────────────────────────────────────
// 元素经 STR 渲染后以 sep 连接;空数组得 ""。
// 与 collection.JOIN 同语义(那边 §5 有同名成员),但 `std.str` 的契约在
// §6 —— 两个命名空间各有一份是规范有意为之(§6/§5 各自的表),调用面不同。
LET(JOIN, FUN((arr, sep),
    (LET(xs, _NEED_ARR("JOIN", arr));
     LET(sp, _NEED_STR("JOIN", sep));
     LET MUT(s, "");
     LET MUT(first, TRUE);
     FOR(v, xs,
         (IF(first, SET(first, FALSE), SET(s, +(s, sp)));
          SET(s, +(s, STR(v)))));
     s)));

// ── SPLIT_LINES(s) -> ARRAY ─────────────────────────────────────────
// 按 \n 切分并去除行尾 \r;尾随换行不产生空尾元素;空串得 [];无换行得 [s]。
//
// 四条边界逐条对:
//   ""          → []        (SPLIT("", "\n") 给 [""],所以必须特判)
//   "a"         → ["a"]
//   "a\n"       → ["a"]     (末尾空元素不算一行)
//   "a\n\nb"    → ["a", "", "b"]  ← 中间的空行**要**保留,只丢末尾那个
//   "a\r\nb"    → ["a", "b"] (逐元素去行尾 \r)
LET(SPLIT_LINES, FUN((s),
    (LET(str, _NEED_STR("SPLIT_LINES", s));
     IF(==(str, ""),
        [],
        (LET MUT(out, []);
         FOR(p, SPLIT(str, "\n"),
             SET(out, PUSH(out, IF(ENDS_WITH(p, "\r"), SUB(p, 0, -(LEN(p), 1)), p))));
         // 尾随换行:只丢**末尾**那个空元素。用 AT 取末位而不是 INDEX ——
         // INDEX 找的是**首**个匹配,`"\n"` 切出的 ["", ""] 里首尾都是空串,
         // 按 INDEX 判会一个都不丢,结果成了两个空行而不是一个。
         IF(==(AT(out, -(LEN(out), 1), NULL), ""),
            SLICE(out, 0, -(LEN(out), 1)),
            out))))));

// ── CHAR_AT(s, i) -> STRING ─────────────────────────────────────────
// 取第 i 个码点,等价于 SUB(s, i, 1);越界口径同 SUB(实测 SUB 越界返回
// "" 而不报错,这里不额外发明行为)。
LET(CHAR_AT, FUN((s, i),
    (LET(str, _NEED_STR("CHAR_AT", s));
     LET(idx, _NEED_INT("CHAR_AT", i));
     SUB(str, idx, 1))));

// ── COUNT(s, sub) -> INTEGER ────────────────────────────────────────
// sub 的非重叠出现次数。
//
// 一次 SPLIT 就够:SPLIT 按分隔符切成 n+1 段,非重叠出现次数正是 n。这比
// 「逐位置试子串」既短又与非重叠口径天然对齐 ——
//   COUNT("aaa", "a")   → SPLIT 得 4 段 → 3(重叠实现会给 3,但 "aaaa" 就会分成 2)
//   COUNT("aaaa", "aa") → SPLIT 得 3 段 → 2(重叠实现会给 3)✓
LET(COUNT, FUN((s, sub),
    (LET(str, _NEED_STR("COUNT", s));
     LET(needle, _NEED_SUB("COUNT", sub));
     -(LEN(SPLIT(str, needle)), 1))));

// ── INDEX_OF(s, sub, from?) -> INTEGER ────────────────────────────────
// sub 在 s 中**首次**出现的码点下标(0 起),无则 -1;from 把起点推到后面,
// 于是「找出全部出现位置」可以写成反复调用的循环。
//
// 为什么要有 from:`COUNT` 数得出个数,却说不出**在哪** —— 这是本模块
// v0.11.2 之前唯一真正缺的能力(全局 `INDEX` 只吃数组,`FIND` 是
// `std.collection` 的数组成员)。没有 from 就只能从 0 开始反复扫全文,
// 而那正是 O(n·m)。
//
// 下标是**码点**下标不是字节下标,与 `CHAR_AT` / `SUB` / `CODEPOINTS`
// 同一口径;拿它去 `SUB(s, i, n)` 可以直接切出那段子串。
//
// 空 sub 报 E0030,与 `COUNT` 同口径(见 `_NEED_SUB`)。
// 负 from 一律钳到 0 —— 本成员按「前向检索」定义,负下标那套是
// `SUB` 的从尾计数,混进来会让 from 语义依赖调用方记得两件事。
LET(INDEX_OF, FUN((*args),
    (_NEED_ARITY("INDEX_OF", args, 2, 3);
     LET(str, _NEED_STR("INDEX_OF", AT(args, 0, NULL)));
     LET(needle, _NEED_SUB("INDEX_OF", AT(args, 1, NULL)));
     LET MUT(from, 0);
     IF(>(LEN(args), 2),
        (LET(f, _NEED_INT("INDEX_OF", AT(args, 2, NULL)));
         SET(from, IF(<(f, 0), 0, f))));
     // `SUB` 越界会钳制,故 i 接近末尾时取到的短串自然 != needle,循环
     // 不需要额外的边界判断。提前退出靠 `found` 哨兵(-1 表示还没找到)。
     LET MUT(found, -1);
     LET MUT(i, from);
     WHILE(&&(<(i, LEN(str)), ==(found, -1)),
         (IF(==(SUB(str, i, LEN(needle)), needle),
            SET(found, i),
            SET(i, +(i, 1)))));
     found)));

// ── CONTAINS_SUB(s, sub) -> BOOLEAN ────────────────────────────────────
// `CONTAINS` 只吃数组(全局内建 §10.4),这里是字符串的同名能力。
// 定义成「`INDEX_OF` 找到位置了吗」而不是另写一遍扫描:少一处口径要同步,
// 也少一处将来要改的地方。
//
// 空 sub 报 E0030,与 `COUNT` / `INDEX_OF` 同口径。
LET(CONTAINS_SUB, FUN((s, sub),
    (LET(str, _NEED_STR("CONTAINS_SUB", s));
     LET(needle, _NEED_SUB("CONTAINS_SUB", sub));
     >(INDEX_OF(str, needle), -1))));

// ── QUOTE(s) -> STRING(M1 落地,M3 不动)─────────────────────────────
LET(QUOTE, FUN((s), (
    LET(cps, CODEPOINTS(s));
    LET MUT(out, [34]);
    FOR(c, cps,
        IF(=(c, 34),
           (SET(out, PUSH(out, 92)); SET(out, PUSH(out, 34))),
           IF(=(c, 92),
              (SET(out, PUSH(out, 92)); SET(out, PUSH(out, 92))),
              IF(=(c, 10),
                 (SET(out, PUSH(out, 92)); SET(out, PUSH(out, 110))),
                 IF(=(c, 9),
                    (SET(out, PUSH(out, 92)); SET(out, PUSH(out, 116))),
                    IF(=(c, 13),
                       (SET(out, PUSH(out, 92)); SET(out, PUSH(out, 114))),
                       SET(out, PUSH(out, c))))))));
    FROM_CODEPOINTS(CONCAT(out, [34]))
)));

// EXPORT 顺序跟随标准库规范 §6 表格的行序(JOIN / SPLIT_LINES / CHAR_AT /
// COUNT / QUOTE / INDEX_OF / CONTAINS_SUB);附录 A 镜像跟随本顺序。成员
// **集合**由 `wlwl-eval/tests/str_math_contract.rs` 对 §6 表格做外部对照。
//
// v0.11.2 M2 追加的 `INDEX_OF` / `CONTAINS_SUB` 接在末尾,不插在 `COUNT`
// 旁边 —— 插进去会让契约测试里那份「点名清单」与 §5/§7 的行序约定都要跟着
// 挪,而顺序本身不承载语义(只承载「与规范表同序」这一条)。
// [W-28] `QUERY_PARSE(...)` —— **URL query 解析**。同样**追加在末尾**
// (规范 §6 的成员表里没有它 ⇒ 它是规范外新增的成员;处置与 `CAT` 同款:
// 接在末尾,不插进 §6 表的行序中间)。
// [项目扩展 / G-21] `CAT(...)` —— **变长拼接**。
//
// ⚠ 为什么需要：语言里的 `+` 是**二元**的（`+(a, b, c)` ⇒ E0022）⇒ 拼 N 段要嵌套 N-1 次。
//   而本模块**早就有一个**变长拼接助手（`_MSG`，模块内私有）——
//   ⚠ **标准库自己就在绕这个缺口** ⇒ 这条缺口的实证就在标准库源码里。
//
//   契约：`CAT()` ⇒ `""`；`CAT("a")` ⇒ `"a"`；`CAT("a", 1, TRUE)` ⇒ 逐段用 `STR` 渲染后拼接
//   （与 `JOIN` 的渲染口径一致）。
//
// ⚠ **为什么不能直接导出 `_MSG`**：`_MSG` 是**只拼字符串**的
//   （`+(s, p)` 遇非字符串直接 `E0030: +: cannot add string and integer`），
//   而 `CAT` 的契约是「逐段 `STR` 渲染」⇒ 必须自己写一个。
//
// [v0.12.0 / S-1 甲案] `CAT` 归 **R2 原生内核**(`_CAT`,见
// `wlwl-std/src/kernels.rs::kernel_cat`):变长拼接 + O(n) 缓冲(R1 的
// `SET(out, +(out, STR(p)))` 每段复制整个字符串 ⇒ O(n²))。
//
// 形态与 `std.result` 的 `RESULT_ALL` / `RESULT_ANY` / `TAKE_ERR` **同款**:
//**kernel 注入 + 门面直接改名导出**(门面是**别名**,不是包装闭包)⇒
// `EXPORT` 名单、成员名、签名、语义一字未变,只有「层」这一列变。
//
// ⚠ 「实参为 `ERR` ⇒ 不渲染、不拼接,结果就是那个 `ERR`」这条规则写在
//   **语言层**(§12.6 透明传播:`CAT` 不在 §8.3 消费者注册表里 ⇒ 调用边界
//   短路,函数体不被求值)⇒ 换层**不换语义**。
LET(CAT, _CAT);

// ── QUERY_PARSE 的私有助手(不导出)─────────────────────────────────────

// 把 `parts` 从 `from` 起的那几段用 `sep` 接回去。
//
// ⚠ 为什么不能直接用 `SPLIT` 的结果:`SPLIT` 只能按分隔符**全**切,而 query 的
//   **值里可以合法地含 `=`**(例如 `a=b=c` ⇒ 键是 `a`、值是 `b=c`)⇒ 切完要把
//   后半段接回去,否则值只剩 `b`。
LET(_JOIN_FROM, FUN((parts, from, sep),
    (LET MUT(out, "");
     LET MUT(first, TRUE);
     FOR(p, SLICE(parts, from, LEN(parts)),
         (IF(first, (SET(out, p); SET(first, FALSE)),
                 SET(out, +(out, +(sep, p))))));
     out)));

// 运行期可预期失败的统一形状(与 `std.http` 的 `HttpError` 同款):
// `ERR([kind, op, reason])`。
//
// ⚠ 它**返回**那个 `ERR` 值(不是把它丢掉)⇒ 未消费状态随返回值**转移**给
//   调用方 ⇒ 调用方必须消费或显式丢弃(`LET(_, r)`),否则作用域结束时报
//   `E0103`。
LET(_QUERY_ERR, FUN((reason), ERR(["kind": "QueryError", "op": "QUERY_PARSE", "reason": reason])));

// 解码一个键/值:`+` → 空格,再 `%XX` 百分号解码。
//
// 返回 `STRING`;非法百分号转义 ⇒ `ERR([kind:"QueryError", …])` **值**。
//
// ⚠ **顺序不能反**:先 `+` → 空格,再 `%XX` 解码。反过来的话 `%2B`
//   (编码后的**字面** `+`)会被错折成空格 —— 那是把「数据里的加号」和
//   「编码里的加号」混成了一件事。
// ⚠ `URL_DECODE` 走 RFC 3986(§11.3-2):它**不**折 `+` ⇒ 那一步只能由本
//   模块做。
LET(_QUERY_DECODE, FUN((s),
    (LET(dec, URL_DECODE(REPLACE(s, "+", " ")));
     IF(IS_ERR(dec),
        (LET(p, ERR_PAYLOAD(dec));
         _QUERY_ERR(AT(p, "reason", "invalid percent-escape"))),
        dec))));

// 把 `k` / `v` 记进 `out`,返回**新**的字典。
//
// 同名键 ⇒ 值升级成 `ARRAY[STRING]`(按出现序):第一次是 `STRING`,
// 第二次起是 `["第一次", "第二次"]`。这与 `std.http::PARSE_REQUEST` 的
// 「同名多值」同款(那边是头名,这里是 query 键)。
LET(_QUERY_PUT, FUN((out, k, v),
    (LET(cur, AT(out, k, NULL));
     IF(==(TYPE(cur), "NULL"),
        INDEX_SET(out, k, v),
        (IF(==(TYPE(cur), "ARRAY"),
           INDEX_SET(out, k, PUSH(cur, v)),
           INDEX_SET(out, k, [cur, v])))))));

// 处理**一个**键值对(`seg`):成功 ⇒ 新字典;失败 ⇒ `ERR` 值。
//
// ⚠ 它把「一个键值对」这件事**整个**封在一层里 ⇒ `QUERY_PARSE` 的循环体
//   只剩「调它 + 判 `ERR`」两件事 —— 少一层嵌套,少一处括号要数。
LET(_QUERY_ONE, FUN((out, seg),
    (LET(kv, SPLIT(seg, "="));
     LET(k, _QUERY_DECODE(AT(kv, 0, "")));
     IF(IS_ERR(k),
        k,
        (LET(v, _QUERY_DECODE(_JOIN_FROM(kv, 1, "=")));
         IF(IS_ERR(v),
            v,
            _QUERY_PUT(out, k, v)))))));

// ── QUERY_PARSE(query) -> DICT ──────────────────────────────────────────
//
// 解析 URL 的 query 串 ⇒ 键值对字典。
//
// · 分隔符:`&` 分隔**键值对**,`=` 分隔**键与值**(值里可以再含 `=`,**只切
//   第一个** —— `a=b=c` ⇒ 键 `a`、值 `b=c`)。
// · **重复键全部保留**:出现一次 ⇒ 值是 `STRING`;出现多次 ⇒ 值是
//   `ARRAY[STRING]`(按出现序)。
// · `+` ⇒ **空格**(`application/x-www-form-urlencoded` 的表单约定)。
// · `%XX` ⇒ 百分号解码(走 `std.encode::URL_DECODE`)。
// · **空串** ⇒ **空 `DICT`**。
// · **无 `=` 的键** ⇒ 值取**空串**。
// · 空段(`a=1&&b=2` 中间那个、`a=1&` 末尾那个)**跳过**。
// · 失败:非法百分号转义 ⇒ `ERR([kind:"QueryError", …])` **值**(不是诊断)。
//
// ⚠ **元数 / 类型错** ⇒ 既有 `E0022` / `E0030`;**不新增诊断码**。
// ⚠ **不吞 `ERR`**:解码失败时本成员**返回**那个 `ERR` 值(未消费状态随
//   返回值转移给调用方)⇒ 调用方要么消费,要么显式丢弃(`LET(_, r)`)。
LET(QUERY_PARSE, FUN((q),
    (LET(str, _NEED_STR("QUERY_PARSE", q));
     LET MUT(out, DICT());
     LET MUT(err, NULL);
     LET(parts, SPLIT(str, "&"));
     LET MUT(i, 0);
     WHILE(<(i, LEN(parts)),
         (LET(seg, AT(parts, i, ""));
          IF(==(seg, ""),
             SET(i, +(i, 1)),
             (LET(res, _QUERY_ONE(out, seg));
              IF(IS_ERR(res),
                 (SET(err, res); SET(i, LEN(parts))),
                 (SET(out, res); SET(i, +(i, 1))))))));
     IF(IS_ERR(err), err, out))));

EXPORT(["JOIN", "SPLIT_LINES", "CHAR_AT", "COUNT", "QUOTE", "INDEX_OF", "CONTAINS_SUB", "CAT", "QUERY_PARSE"]);
