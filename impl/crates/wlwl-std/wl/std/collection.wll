// wlwl:std.collection — R1 语言层(标准库底座 v0.11,ADR-0021)
// 成员契约:docs/stdlib/wlwl-stdlib-spec-v0.11.md §5;注册镜像:附录 A。
//
// M3-1 起本模块是 std.collection 的**门面实现**(原 R2 Rust 实现已删)。
// 算法、循环、比较全部是 wlwl;只有四样东西走注入的 R2 内核(ADR-0021
// §层间规则,见 wlwl-std/src/kernels.rs):
//
//   _KIND(x)          值种类的诊断措辞(与 R2 的消息逐字对齐)
//   _DIAG_E0020(msg)  回调不可调用
//   _DIAG_E0022(msg)  元数不符(仅变长元数成员需要)
//   _DIAG_E0030(msg)  类型错
//   _RANGE(...)       RANGE 本身 —— M5 裁决单独沉回 R2(基准实测 R1 版每元素
//                     成本超线性,见 D11-012),门面只改名导出
//
// [D11-019] 原先这里还列着 `_DIAG_E0038(msg)`,并称「E0038 全仓唯一的发射点
// 就在这里」—— M5 之后不成立:唯一发射点是 `collection.rs` 的
// `kernel_range`。该注入已作为死注入删除。
//
// 为什么要自己发诊断码:wlwl 源码**发不出**指定码的原生诊断(实测
// PANIC → E0100;LEN(1) → E0030 但消息被 LEN 固定;闭包元数错 → E0022 但
// 消息无函数名前缀)。
//
// 两条 ERR 语义在本模块是**语言给的**,不是本模块写的:
//   · 实参里的 ERR —— 闭包调用边界直接透传(§8.2),成员体根本看不到它;
//   · 回调返回的 ERR —— 必须显式判 `IS_ERR` 后原样返回,否则会被当成
//     普通值 PUSH 进结果里(R2 走的是同一条路)。
//
// 元数写法:全部用 `FUN((*args), ..)`。这样变长成员(SORT 1–2 / RANGE 1–3 /
// ZIP ≥1 / ANY·ALL 1–2)的元数检查由门面自己做,消息能指名道姓;固定元数
// 成员则由 `_NEED_ARITY` 统一把关。

// ── 助手(不导出;`_` 前缀既不撞全局内建也不进附录 A)────────────────

// 拼消息。R2 的诊断文案逐字照抄,免得 M3 的措辞变化被人当成回归。
LET(_CAT, FUN((*parts), (LET MUT(s, ""); FOR(p, parts, SET(s, +(s, p))); s)));

// `NAME: expected <what>, got <kind>`
LET(_NEED, FUN((name, what, ty, v),
    IF(==(TYPE(v), ty), v, _DIAG_E0030(_CAT(name, ": expected ", what, ", got ", _KIND(v))))));

LET(_NEED_ARR, FUN((name, v), _NEED(name, "array", "ARRAY", v)));
// [D11-019] 原有 `_NEED_INT`,全模块无调用点(RANGE 沉 R2 后元数与元素
// 类型检查一并归 R2),已删。

LET(_NEED_FN, FUN((name, v),
    IF(==(TYPE(v), "FUNCTION"),
       v,
       _DIAG_E0020(_CAT(name, ": callback is not callable (got ", _KIND(v), ")")))));

// 元数窗口 [lo, hi]。R2 的措辞只报上限(`SORT: function expects 2
// argument(s), got 3`),这里照抄。
LET(_NEED_ARITY, FUN((name, args, lo, hi),
    IF(||(<(LEN(args), lo), >(LEN(args), hi)),
       _DIAG_E0022(_CAT(name, ": function expects ", STR(hi), " argument(s), got ", STR(LEN(args)))),
       NULL)));

// 1. MAP(arr, f)  →  [f(v), ...]
LET(MAP, FUN((*args),
    (_NEED_ARITY("MAP", args, 2, 2);
     LET(arr, _NEED_ARR("MAP", AT(args, 0, NULL)));
     LET(f, _NEED_FN("MAP", AT(args, 1, NULL)));
     LET MUT(out, []);
     LET MUT(err, NULL);
     LET MUT(i, 0);
     WHILE(<(i, LEN(arr)),
         (LET(r, CALL(f, AT(arr, i, NULL)));
          IF(IS_ERR(r), SET(err, r), SET(out, PUSH(out, r)));
          SET(i, +(i, 1))));
     IF(IS_ERR(err), err, out))));

// 2. FILTER(arr, f)  →  [v for v in arr if f(v)]
LET(FILTER, FUN((*args),
    (_NEED_ARITY("FILTER", args, 2, 2);
     LET(arr, _NEED_ARR("FILTER", AT(args, 0, NULL)));
     LET(f, _NEED_FN("FILTER", AT(args, 1, NULL)));
     LET MUT(out, []);
     LET MUT(err, NULL);
     LET MUT(i, 0);
     WHILE(<(i, LEN(arr)),
         (LET(v, AT(arr, i, NULL));
          LET(r, CALL(f, v));
          IF(IS_ERR(r),
             SET(err, r),
             IF(==(TYPE(r), "BOOLEAN"),
                IF(r, SET(out, PUSH(out, v)), NULL),
                _DIAG_E0030(_CAT("FILTER", ": predicate must return BOOLEAN, got ", _KIND(r)))));
          SET(i, +(i, 1))));
     IF(IS_ERR(err), err, out))));

// 3. REDUCE(arr, f, init)  →  左折叠;空数组返回 init
LET(REDUCE, FUN((*args),
    (_NEED_ARITY("REDUCE", args, 3, 3);
     LET(arr, _NEED_ARR("REDUCE", AT(args, 0, NULL)));
     LET(f, _NEED_FN("REDUCE", AT(args, 1, NULL)));
     LET MUT(acc, AT(args, 2, NULL));
     LET MUT(err, NULL);
     LET MUT(i, 0);
     WHILE(<(i, LEN(arr)),
         (LET(r, CALL(f, acc, AT(arr, i, NULL)));
          IF(IS_ERR(r), (SET(err, r); SET(i, LEN(arr))), SET(acc, r));
          IF(IS_ERR(err), NULL, SET(i, +(i, 1)))));
     IF(IS_ERR(err), err, acc))));

// 数值?(`INTEGER` 与 `FLOAT` 跨类型按 §2.2 提升后比大小)
LET(_NUM, FUN((v), ||(==(TYPE(v), "INTEGER"), ==(TYPE(v), "FLOAT"))));

// 缺省排序键:a 排在 b 前面吗。
//
// **不可比返回 FALSE,而不是让 `<` 抛 E0030。** 这是 R2 `default_less` 的
// 契约(混合类型排序保持原序,`SORT([1, "a", 2])` → `[1, a, 2]`),而语言的
// `<` 对不可比操作数是**严格**的。规范 §5 只说「升序排序」没规定混合类型,
// 故按「规范沉默处保留既有实现」处理,把这条行为原样搬过来 —— 改用 `<`
// 会让原本能跑的排序变成 E0030,那是破坏性变更。
LET(_SORT_LT, FUN((cmp, a, b),
    (IF(==(TYPE(cmp), "NULL"),
       IF(||(&&(_NUM(a), _NUM(b)),
             ||(&&(==(TYPE(a), "STRING"), ==(TYPE(b), "STRING")),
                &&(==(TYPE(a), "BOOLEAN"), ==(TYPE(b), "BOOLEAN")))),
          <(a, b),
          FALSE),
       // 给了比较器就用它。顺带把「比较器必须返回 BOOLEAN」这条 R2 契约
       // 守住 —— 不然 `IF` 会按真值(§2.3)把非布尔当真,静默改变排序结果。
       //
       // [D11-019] 比较器返 `ERR` 必须**先**用 `IS_ERR` 拦住,原样交回调用方
       // (stdlib §5:成员回调抛出的 ERR 使整个调用按 8.2 传播)。
       // 原先这里是 `IF(==(TYPE(lt), "BOOLEAN"), lt, _DIAG_E0030(...))`:
       // `TYPE` 是 ERR 消费者,把 ERR 变成字符串 `"RESULT"` ⇒ 判假进 else 分支;
       // 而 else 的实参 `_KIND(lt)` **不是** ERR 消费者,ERR 在算实参时就
       // 透明传播掉了,`_DIAG_E0030` 一次都没被调用,整条表达式成了那个 ERR。
       // 那个 ERR 再经 `||` / `IF` 的**条件位**传到语句位被 §8.5 静默丢弃 ⇒
       // `SORT` 退化成「每轮取剩余首个」,原序返回、零诊断。
       // `IS_ERR` 是消费者,接得住。
       (LET(lt, CALL(cmp, a, b));
        IF(IS_ERR(lt),
           lt,
           IF(==(TYPE(lt), "BOOLEAN"),
              lt,
              _DIAG_E0030(_CAT("SORT", ": comparator must return BOOLEAN, got ", _KIND(lt))))))))));

// 4. SORT(arr) / SORT(arr, cmp)  →  升序;稳定
//
// 选择排序(每轮取剩余里最靠前者)而不是插入排序:wlwl 数组不可变,元素搬移
// 要一次 INDEX_SET = 一次 O(n) 拷贝;选择排序每轮只有一次 SLICE + 一次
// PUSH,总拷贝量 O(n) 而不是 O(n²)。取**第一个**最小值 ⇒ 稳定,与 R2 的
// `Vec::sort_by`(稳定)一致 —— 混合类型不可比时 R2 全部判 Equal 从而
// 保留原序,本实现同样如此。
//
// [D11-019] `err` 累加器:比较器返 `ERR` 时**终止整个调用**并把 ERR 交回
// 调用方(与 MAP / FILTER / REDUCE / SORT_BY 同一套写法,见上方各成员)。
// 此前 `_SORT_LT` 的结果直接落在 `||` / `IF` 的条件位上,ERR 在那里被
// §8.5 静默丢弃,排序循环照跑完 ⇒ 零诊断 + 原序返回。
// `_SORT_LT` 也**不能**直接落在条件位上,理由同上;而比较结果必须先落
// 变量再判 `IS_ERR`,与 §8.2「传播不消耗、不改写 ERR」一致。
LET(SORT, FUN((*args),
    (_NEED_ARITY("SORT", args, 1, 2);
     LET(arr, _NEED_ARR("SORT", AT(args, 0, NULL)));
     LET(cmp, AT(args, 1, NULL));
     IF(==(TYPE(cmp), "NULL"), NULL, _NEED_FN("SORT", cmp));
     LET MUT(rest, SLICE(arr, 0));
     LET MUT(out, []);
     LET MUT(err, NULL);
     WHILE(>(LEN(rest), 0),
         (LET MUT(best, -1);
          LET MUT(bestv, NULL);
          LET MUT(i, 0);
          WHILE(<(i, LEN(rest)),
              (LET(v, AT(rest, i, NULL));
               // `==(best, -1)` 为真时**不调**比较器(首轮没有前驱可比)。
               // 原先这个短路发生在 `||` 的左操作数上;比较结果要落变量
               // 才能判 `IS_ERR`,故在此显式写出同一短路,别把它改回调用。
               LET(less, IF(==(best, -1), FALSE, _SORT_LT(cmp, v, bestv)));
               IF(IS_ERR(less),
                  (SET(err, less); SET(i, LEN(rest))),
                  IF(||(==(best, -1), less),
                     (SET(best, i); SET(bestv, v)),
                     NULL));
               SET(i, +(i, 1))));
          IF(IS_ERR(err),
             SET(rest, []),
             (SET(out, PUSH(out, bestv));
              SET(rest, CONCAT(SLICE(rest, 0, best), SLICE(rest, +(best, 1))))))));
     IF(IS_ERR(err), err, out))));

// 5. SORT_BY(arr, key)  →  以 key(v) 升序
// 投影一次、连同原值一起排,再把原值取回来(与 R2 的 decorate-sort-
// undecorate 同构)。
LET(SORT_BY, FUN((*args),
    (_NEED_ARITY("SORT_BY", args, 2, 2);
     LET(arr, _NEED_ARR("SORT_BY", AT(args, 0, NULL)));
     LET(key, _NEED_FN("SORT_BY", AT(args, 1, NULL)));
     LET MUT(pairs, []);
     LET MUT(err, NULL);
     LET MUT(i, 0);
     WHILE(<(i, LEN(arr)),
         (LET(v, AT(arr, i, NULL));
          LET(k, CALL(key, v));
          IF(IS_ERR(k), (SET(err, k); SET(i, LEN(arr))), SET(pairs, PUSH(pairs, [k, v])));
          IF(IS_ERR(err), NULL, SET(i, +(i, 1)))));
     IF(IS_ERR(err),
        err,
        MAP(SORT(pairs, FUN((p, q), _SORT_LT(NULL, AT(p, 0, NULL), AT(q, 0, NULL)))),
            FUN((p), AT(p, 1, NULL)))))));

// 6. ZIP(a, b, ...)  →  配对至较短者
// 非数组实参按单列处理(R2 同款:规范没写,沿用既有实现以免行为漂移)。
LET(ZIP, FUN((*args),
    (IF(<(LEN(args), 1),
        _DIAG_E0022(_CAT("ZIP", ": function expects 1 argument(s), got ", STR(LEN(args)))),
        NULL);
     LET MUT(cols, []);
     FOR(a, args, SET(cols, PUSH(cols, IF(==(TYPE(a), "ARRAY"), a, [a]))));
     LET MUT(minlen, -1);
     FOR(c, cols, SET(minlen, IF(==(minlen, -1), LEN(c), IF(<(minlen, LEN(c)), minlen, LEN(c)))));
     LET MUT(out, []);
     LET MUT(i, 0);
     WHILE(<(i, minlen),
         (LET MUT(row, []);
          FOR(c, cols, SET(row, PUSH(row, AT(c, i, NULL))));
          SET(out, PUSH(out, row));
          SET(i, +(i, 1))));
     out)));


// ── 7. RANGE(n) / RANGE(start, end) / RANGE(start, end, step)  →  [start, end)
//
// [v0.11 M5] **本成员已沉回 R2 实现**,门面只改名导出。层归属变更不算
// 破坏性变更(ADR-0021 §0.2),故导出面 / 签名 / 语义 / 诊断一字未变。
//
// 依据是基准实测(release 档、单线程):R1 版 `RANGE(0, 10 000)` 3 623 ms、
// `RANGE(0, 40 000)` 86 036 ms,每元素成本**超线性**;对照 R2 时代
// `RANGE(1, 1 000 001, 1)` 加上 100 万次 FOR 整体只要 536–551 ms。根因不是
// 解释器慢,而是语言层**无法线性建数组**:wlwl 数组不可变,`PUSH` 每次复制
// 整个数组。于是语言规范 §6.6 的「100 万次简单循环 < 30 s」负载跑不完,
// 时间还全花在**循环开始之前**。
//
// 局限要说清:同一成本剖面适用于**所有**建数组的成员(`MAP` / `FILTER` /
// `FLAT` / `UNIQ` / `ENUMERATE` / `GROUP_BY` / `JOIN` 都走 `PUSH`),所以
// 只沉 `RANGE` 是治标。根因修复(解释器侧写时复制 / 结构共享)超批次 A 范围。
// 详见偏差 D11-012 与 `wlwl-std/benches/baseline.txt` 的 M5 段。
LET(RANGE, _RANGE);


// 8/9. ANY(arr, f?) / ALL(arr, f?)  —— 缺省 f 时按真值(§2.3)
LET(ANY, FUN((*args),
    (_NEED_ARITY("ANY", args, 1, 2);
     LET(arr, _NEED_ARR("ANY", AT(args, 0, NULL)));
     LET(f, AT(args, 1, NULL));
     IF(==(TYPE(f), "NULL"), NULL, _NEED_FN("ANY", f));
     LET MUT(found, FALSE);
     LET MUT(err, NULL);
     LET MUT(i, 0);
     WHILE(<(i, LEN(arr)),
         (LET(v, AT(arr, i, NULL));
          LET(x, IF(==(TYPE(f), "NULL"), v, CALL(f, v)));
          IF(IS_ERR(x),
             (SET(err, x); SET(i, LEN(arr))),
             IF(BOOL(x), (SET(found, TRUE); SET(i, LEN(arr))), SET(i, +(i, 1))))));
     IF(IS_ERR(err), err, found))));

LET(ALL, FUN((*args),
    (_NEED_ARITY("ALL", args, 1, 2);
     LET(arr, _NEED_ARR("ALL", AT(args, 0, NULL)));
     LET(f, AT(args, 1, NULL));
     IF(==(TYPE(f), "NULL"), NULL, _NEED_FN("ALL", f));
     LET MUT(ok, TRUE);
     LET MUT(err, NULL);
     LET MUT(i, 0);
     WHILE(<(i, LEN(arr)),
         (LET(v, AT(arr, i, NULL));
          LET(x, IF(==(TYPE(f), "NULL"), v, CALL(f, v)));
          IF(IS_ERR(x),
             (SET(err, x); SET(i, LEN(arr))),
             IF(BOOL(x), SET(i, +(i, 1)), (SET(ok, FALSE); SET(i, LEN(arr)))))));
     IF(IS_ERR(err), err, ok))));

// 10. FIND(arr, f)  →  首个满足者,无则 NULL
LET(FIND, FUN((*args),
    (_NEED_ARITY("FIND", args, 2, 2);
     LET(arr, _NEED_ARR("FIND", AT(args, 0, NULL)));
     LET(f, _NEED_FN("FIND", AT(args, 1, NULL)));
     LET MUT(hit, NULL);
     LET MUT(err, NULL);
     LET MUT(i, 0);
     WHILE(<(i, LEN(arr)),
         (LET(r, CALL(f, AT(arr, i, NULL)));
          IF(IS_ERR(r),
             (SET(err, r); SET(i, LEN(arr))),
             IF(==(TYPE(r), "BOOLEAN"),
                IF(r, (SET(hit, AT(arr, i, NULL)); SET(i, LEN(arr))), SET(i, +(i, 1))),
                _DIAG_E0030(_CAT("FIND", ": predicate must return BOOLEAN, got ", _KIND(r)))))));
     IF(IS_ERR(err), err, hit))));

// 11. ENUMERATE(arr)  →  [[0, v0], [1, v1], ...]
LET(ENUMERATE, FUN((*args),
    (_NEED_ARITY("ENUMERATE", args, 1, 1);
     LET(arr, _NEED_ARR("ENUMERATE", AT(args, 0, NULL)));
     LET MUT(out, []);
     LET MUT(i, 0);
     WHILE(<(i, LEN(arr)),
         (SET(out, PUSH(out, [i, AT(arr, i, NULL)]));
          SET(i, +(i, 1))));
     out)));

// 12/13. TAKE(arr, n) / DROP(arr, n)  —— n < 0 时 TAKE 得 []、DROP 是 no-op
LET(TAKE, FUN((*args),
    (_NEED_ARITY("TAKE", args, 2, 2);
     LET(arr, _NEED_ARR("TAKE", AT(args, 0, NULL)));
     LET(n, AT(args, 1, NULL));
     IF(==(TYPE(n), "INTEGER"),
        NULL,
        _DIAG_E0030(_CAT("TAKE", ": expected non-negative integer, got ", _KIND(n))));
     IF(<(n, 0), [], SLICE(arr, 0, n)))));

LET(DROP, FUN((*args),
    (_NEED_ARITY("DROP", args, 2, 2);
     LET(arr, _NEED_ARR("DROP", AT(args, 0, NULL)));
     LET(n, AT(args, 1, NULL));
     IF(==(TYPE(n), "INTEGER"),
        NULL,
        _DIAG_E0030(_CAT("DROP", ": expected non-negative integer, got ", _KIND(n))));
     IF(<(n, 0), arr, SLICE(arr, n)))));

// 14. FLAT(arr)  →  展平一层
LET(FLAT, FUN((*args),
    (_NEED_ARITY("FLAT", args, 1, 1);
     LET(arr, _NEED_ARR("FLAT", AT(args, 0, NULL)));
     LET MUT(out, []);
     FOR(v, arr, SET(out, IF(==(TYPE(v), "ARRAY"), CONCAT(out, v), PUSH(out, v))));
     out)));

// 15. UNIQ(arr)  →  按 == 去重,保留首现
// `INDEX` 的 1-based 查找用的就是值相等语义(与 R2 的 `values_equal`
// 同一条:1 与 1.0 互等),所以 -1 就是没见过的判据。
LET(UNIQ, FUN((*args),
    (_NEED_ARITY("UNIQ", args, 1, 1);
     LET(arr, _NEED_ARR("UNIQ", AT(args, 0, NULL)));
     LET MUT(out, []);
     FOR(v, arr, IF(==(INDEX(out, v), -1), SET(out, PUSH(out, v)), NULL));
     out)));

// 16. GROUP_BY(arr, key)  →  DICT;键按 §5 走 STR 渲染(与 R2 的
//     `display()` 一致),组内保持首现序。
LET(GROUP_BY, FUN((*args),
    (_NEED_ARITY("GROUP_BY", args, 2, 2);
     LET(arr, _NEED_ARR("GROUP_BY", AT(args, 0, NULL)));
     LET(f, _NEED_FN("GROUP_BY", AT(args, 1, NULL)));
     LET MUT(d, DICT());
     LET MUT(err, NULL);
     LET MUT(i, 0);
     WHILE(<(i, LEN(arr)),
         (LET(v, AT(arr, i, NULL));
          LET(k, CALL(f, v));
          IF(IS_ERR(k),
             (SET(err, k); SET(i, LEN(arr))),
             (LET(ks, STR(k));
              SET(d, IF(HAS(d, ks),
                        INDEX_SET(d, ks, PUSH(AT_K(d, ks, []), v)),
                        INDEX_SET(d, ks, [v])))));
          IF(IS_ERR(err), NULL, SET(i, +(i, 1)))));
     IF(IS_ERR(err), err, d))));

// 17. JOIN(arr, sep)  →  元素经 STR 渲染后以 sep 连接
LET(JOIN, FUN((*args),
    (_NEED_ARITY("JOIN", args, 2, 2);
     LET(arr, _NEED_ARR("JOIN", AT(args, 0, NULL)));
     LET(sep, AT(args, 1, NULL));
     IF(==(TYPE(sep), "STRING"),
        NULL,
        _DIAG_E0030(_CAT("JOIN", ": expected string (separator), got ", _KIND(sep))));
     LET MUT(s, "");
     LET MUT(first, TRUE);
     FOR(v, arr,
         (IF(first, SET(first, FALSE), SET(s, +(s, sep)));
          SET(s, +(s, STR(v)))));
     s)));

// EXPORT 顺序跟随标准库规范 §5 表格的行序;附录 A 镜像跟随本顺序。成员
// **集合**由 `wlwl-eval/tests/collection_contract.rs` 对 §5 表格做外部对照。
// [D11-019] 原文写「对齐 R2 的 `NAMES` 常量(锁测试 `names_match_catalog`
// 对拍)」—— R2 实现删除后那两个东西都不存在了(该恒真锁已在 D11-006 拆除)。
EXPORT(["MAP", "FILTER", "REDUCE", "SORT", "SORT_BY", "ZIP", "RANGE", "ANY", "ALL", "FIND", "ENUMERATE", "TAKE", "DROP", "FLAT", "UNIQ", "GROUP_BY", "JOIN"]);
