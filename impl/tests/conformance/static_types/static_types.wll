// 静态契约 conformance 夹具:每份只带一个静态层能抓出的问题。
//
// 两份读同一个契约(目录约定,照 `conformance/README.md`):
//   第 1 行  `// expects: E0110` —— 开启 `gradual_typing = "error"` 时
//                                     必须出现的码(行末可加多个,空格分隔);
//   第 2 行  `// mode: both`     —— 该夹具在**默认档也必须干净**
//                                     (只列 `both` 与 `off`,不列 `on`);
//
// 约束:夹具必须是**合法且能跑**的 WLWL 程序 —— 静态层是唯一的门,程序本身
// 不能有语法错或运行期错。跑的是**真的二进制**(`wlwl check`),不是内部
// 函数,所以这条测试同时验到「诊断从二进制出来」这条链路。
//
// `mode: both` 的那条(clean_baseline)是**控制组**:它证明这套夹具目录
// 在默认档下不会给仓库添乱 —— 零破坏不是靠断言,是靠控制组。

// expects: E0110
LET(flag: BOOLEAN, "yes");
PRINT(flag);

// expects: E0110 E0111
LET(max: INTEGER, FUN((a: INTEGER, b: INTEGER) : INTEGER, IF(<(a, b), a, b)));
LET(wrong: STRING, max("a", "b"));
max(1, "b");

// expects: E0111
LET(greet, FUN((who: STRING) : STRING, +("hi, ", who)));
PRINT(greet(42));

// expects: E0112
LET(answer: STRING, FUN(() : INTEGER, 42));
PRINT(answer());

// expects: E0111
//   约束只在编译期判定:TRUE 不满足 `T: Comparable`,而运行期的比较算子
//   同样会拒绝它(两组擦除测试共同钉住「运行期不拦」这一条)。
LET(larger, FUN((a: T: Comparable, b: T: Comparable) : T: Comparable, IF(<(a, b), a, b)));
PRINT(larger(1, TRUE));

// expects: E0110
LET(count, FUN((xs: ARRAY[T: Comparable]) : INTEGER, 0));
PRINT(count([1, 2]));

// expects: E0116
LET(shout, FUN((r: RESULT[INTEGER, STRING]) : STRING,
    MATCH(r, [[OK(n), STR("ok")]])));
PRINT(shout(OK(1)));

// expects: W0117
LET(pick, FUN((n: INTEGER) : INTEGER, MATCH(n, [[_, 0], [0, 0]])));
PRINT(pick(1));

// mode: both
LET(fine: INTEGER, 1);
LET(also_fine, FUN((a: INTEGER, b: INTEGER) : INTEGER, +(a, b)));
PRINT(also_fine(fine, 2));

// mode: both
//   与 E0116 那条对照:补上 `ERR` 分支之后穷尽,一条诊断都不该有。
LET(quiet, FUN((r: RESULT[INTEGER, STRING]) : STRING,
    MATCH(r, [[OK(n), STR("ok")], [ERR(e), "err"]])));
PRINT(quiet(OK(1)));
