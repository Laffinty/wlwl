LET MUT(n, 0);
LET(r, FOR(i, [1, 2, 3], (SET(n, +(n, 1)); IF(==(i, 2), ERR("stop"), 1))));
PRINT(n);
PRINT(IS_ERR(r));
// [v1.0 规范 §8.6] `IS_ERR` 是**观察型**消费者 ⇒ 不解除未消费状态(§8.6.1)
// ⇒ `r` 里的 `ERR` 到作用域结束时仍未消费 ⇒ 丢弃点(§8.6.2 第 3 项)
// ⇒ `E0103`。故观察之后显式丢弃(§8.6.4)。本用例要验的是「FOR 体的
// `ERR` 传出了循环」,不是那个 `ERR` 的形状。
LET(_, r)
