// [v0.12.1 · W-23 · D-1] 正则模式的**编译缓存**。
//
// 这条 probe 钉的是**可观察面**。规范 §16.5 的实现注(**非规范**)明写:
// 「模式对象已携带组数,实现**可以**缓存编译结果并以 O(1) 回答」
// ⇒ 缓存是**规范允许**的实现自由度 ⇒ 本项零规范改动、零新成员。
//
// 而「编译了几次」这种**工作量计数在语言面不可见**:报它要新增成员
// ⇒ 撞 D-1 的非目标(零新成员)与一致性册 `:223`(不得改既有成员的语义)。
// ⇒ 计数断言住在 Rust 契约(`wlwl-eval/tests/regex_cache_contract.rs`,
//   确定性计数、不是墙钟 —— 一致性册 §6.2 V-01),这里钉**行为没变**。
//
// 本 probe 的三条断言:
//   ① 模式对象的**形状一字不变**(仍两键:pattern / groups)
//      —— 缓存的句柄**不许**变成第三个键(那会改 LEN / KEYS 这类可观察面);
//   ② 同一个模式对象连用 1000 次,结果与第一次**逐字相同**(命中缓存不改变语义);
//   ③ 换一个**不同**的模式,各自独立、互不串味。
IMPORT("wlwl:std.regex", ["RE", "RE_TEST", "RE_SEARCH", "RE_FIND_ALL", "RE_REPLACE", "RE_SPLIT", "RE_GROUP_COUNT"]);

// ① 模式对象的形状:**两键**(规范 §16.5:「含 pattern 与 groups 两键」)。
LET(p, RE("^p121([0-9]+)q$"));
PRINT("object  = ", p);
PRINT("groups  = ", RE_GROUP_COUNT(p));

// ② 同一个模式对象连用 1000 次:命中缓存 ⇒ 结果与第一次**逐字相同**。
// 期望值按定义算出:每轮匹配到 1 个 ⇒ 累计 1000(不是抄实现输出)。
LET MUT(i, 0);
LET MUT(hits, 0);
WHILE(<(i, 1000), (SET(i, +(i, 1)); SET(hits, +(hits, LEN(RE_FIND_ALL(p, "p12142q"))))));
PRINT("loop    = ", hits);

// ③ 换一个**不同**的模式:各自独立,互不串味。
LET(q, RE("^p121([a-z]+)q$"));
PRINT("test    = ", RE_TEST(q, "p121abcq"));
PRINT("search  = ", RE_SEARCH(q, "p121abcq"));
PRINT("replace = ", RE_REPLACE(RE("([a-z]+)=(\\w+)"), "a=1 b=2", "$2:$1"));
PRINT("split   = ", RE_SPLIT(RE("[,;]"), "a,b;c"));

// 同一个模式串**重新 RE 一次**:返回的模式对象与第一次**逐字相同**(形状没变)。
PRINT("re_again= ", RE("^p121([0-9]+)q$"));
