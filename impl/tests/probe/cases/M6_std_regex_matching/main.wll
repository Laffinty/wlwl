// [v0.11.3 M6 / addendum-02] std.regex:匹配 / 替换 / 病态复杂度三条。
//
// 落点:addendum-02 §5 落点 6(probe ≥ 3 条)。
//
// 第三条是**本成员存在的理由**:`(a*)*b` 在 10 000 个 a 上,回溯引擎跑不完
// (指数爆炸),而本成员走 NFA 模拟、立刻返回「不匹配」。这条 probe 的
// `exit: 0` 与 `contains` 就是断言 —— 若实现哪天引入了回溯,它会**超时**
// 而不是给出错答案。
//
// ⚠ 本轮踩过并记下的两条:① **锚点是有约束的** —— `^…$` 锚的是**整个输入**,
// 所以拿带锚点的模式去找长串里的子串必然 NULL(第一版就栽在这,行为是对的、
// 用例写错了);② 本语言**没有中缀运算符、没有花括号** —— 比较是具名函数
// `=(a, b)` / `>(a, b)`,连接是 `+(a, b)`。
IMPORT("wlwl:std.regex", ["RE", "RE_TEST", "RE_SEARCH", "RE_FIND_ALL", "RE_REPLACE", "RE_SPLIT", "RE_GROUP_COUNT"]);

// 整串匹配:两端锚定,所以只能用「正好是邮箱」的输入。
LET(mail, RE("(?i)^([a-z]+)@([a-z]+)\\.([a-z]{2,})$"));
PRINT("groups   = ", RE_GROUP_COUNT(mail));
PRINT("test     = ", RE_TEST(mail, "someone@example.com"));
PRINT("test_bad = ", RE_TEST(mail, "x someone@example.com y"));

// 找子串:同一个邮箱模式去掉锚点,才能在长串里定位。
PRINT("search   = ", RE_SEARCH(RE("(?i)([a-z]+)@([a-z]+)"), "x someone@example.com y"));
PRINT("find_all = ", LEN(RE_FIND_ALL(RE("[0-9]+"), "a1b22c333")));
PRINT("replace  = ", RE_REPLACE(RE("([a-z]+)=(\\w+)"), "a=1 b=2", "$2:$1"));
PRINT("split    = ", RE_SPLIT(RE("[,;]"), "a,b;c"));

// 病态复杂度:回溯引擎在这里是灾难。
LET(bomb, RE("(a*)*b"));
PRINT("bomb     = ", RE_SEARCH(bomb, REPEAT("a", 10000)));
PRINT("bomb_hit = ", RE_TEST(bomb, +(REPEAT("a", 10000), "b")));